# JSON object mapping public API tenant ids to strong bearer tokens.
# Leave unset to allow only loopback development. Workspace identity is opt-in below.
LINEAGEGUARD_API_KEYS_JSON={"example-tenant":"replace-with-a-secret"}

# Enable only behind a dispatcher that strips user-supplied identity headers.
LINEAGEGUARD_TRUST_WORKSPACE_IDENTITY=false

# Per-isolate safety limit. Use an external gateway for globally coordinated quotas.
LINEAGEGUARD_RATE_LIMIT_PER_MINUTE=60
