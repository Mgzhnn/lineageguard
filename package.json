{
  "name": "lineageguard",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first warning system for claim mutation across AI agent handoffs.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test:engine": "node --experimental-strip-types --test tests/analysis.test.ts tests/pipeline.test.ts tests/trace-schema.test.ts tests/sdk.test.ts tests/runtime.test.ts",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:engine && pnpm typecheck && vinext build && pnpm test:render",
    "demo:agent": "node --experimental-strip-types examples/guarded-agent-runtime.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
