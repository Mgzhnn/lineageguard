{
  "name": "lineageguard",
  "version": "0.5.1",
  "description": "Deterministic claim-lineage analysis and runtime enforcement for AI agent handoffs.",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "agentic-ai",
    "guardrails",
    "lineage",
    "opentelemetry",
    "reliability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mgzhnn/lineageguard.git",
    "directory": "sdk"
  },
  "homepage": "https://lineageguard.ugrp44group.chatgpt.site",
  "bugs": {
    "url": "https://github.com/Mgzhnn/lineageguard/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./runtime": {
      "types": "./dist/sdk/runtime.d.ts",
      "import": "./dist/sdk/runtime.js"
    },
    "./graph": {
      "types": "./dist/sdk/graph.d.ts",
      "import": "./dist/sdk/graph.js"
    },
    "./otel": {
      "types": "./dist/sdk/otel.d.ts",
      "import": "./dist/sdk/otel.js"
    },
    "./analysis": {
      "types": "./dist/lib/analysis.d.ts",
      "import": "./dist/lib/analysis.js"
    },
    "./pipeline": {
      "types": "./dist/lib/pipeline.d.ts",
      "import": "./dist/lib/pipeline.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm -C .. run verify"
  }
}
